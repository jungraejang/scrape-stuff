# Copy this file to .env.local and fill in the values from your Supabase project
# (Project Settings -> API)

# Used by the Next.js frontend (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used ONLY by the scraper script (keep secret, never commit)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Cache revalidation (optional but recommended): after a scrape finishes, the
# scraper POSTs to SITE_URL/api/revalidate with this secret so the site rebuilds
# with fresh data immediately instead of waiting for the ISR fallback.
# SITE_URL is where the running Next.js app is reachable from the scraper.
SITE_URL=http://localhost:3000
REVALIDATE_SECRET=pick-any-long-random-string
SCRAPE_CUTOFF_MONTHS=2    
NEXT_PUBLIC_GA_ID=G-4BP6X331HK
# Optional scraper tuning
# SCRAPE_MAX_PAGES=100          # hard cap on pages fetched per run (default 100)
# SCRAPE_CUTOFF_MONTHS=2        # ignore listings older than this many months (default 2)

# Google Analytics 4 measurement ID (optional; analytics is skipped when unset).
# Find it in GA Admin -> Data Streams -> your web stream ("G-XXXXXXXXXX").
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
